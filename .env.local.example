# העתיקו ל-.env.local לפיתוח מקומי (npm run dev). כל השדות אופציונליים.

# היכן נשמרים הנתונים מקומית. ברירת מחדל: ./.data בתוך הפרויקט.
# DATA_DIR=./.data

# כתובת הבסיס לקישורי שיתוף / QR / שחזור. מקומי:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# אופציונלי — שחזור קישור פרטי במייל דרך Resend.
# בלי שני המשתנים האלה, /recover יגיב שהשחזור-במייל לא מוגדר.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RECOVERY_EMAIL_FROM=onboarding@resend.dev
