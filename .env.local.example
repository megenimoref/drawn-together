# העתיקו קובץ זה ל-.env.local ומלאו ערכים אמיתיים (‎.env.local‎ לא נכנס ל-git).

# Vercel Blob — האחסון של הפרויקט (חובה). בלעדיו יצירת לוח/העלאה ייכשלו עם "Access denied".
# מעתיקים מ-Vercel: Project → Storage → Blob → לשונית ‎.env.local‎
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXX_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# כתובת הבסיס לקישורי שיתוף / QR / שחזור.
# מקומי: http://localhost:3000 · בפרודקשן: הכתובת ב-Vercel
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# אופציונלי — שחזור קישור פרטי במייל דרך Resend.
# בלי שני המשתנים האלה, /recover יגיב שהשחזור-במייל לא מוגדר (המשתמש עדיין יכול להשתמש בקישור השמור).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RECOVERY_EMAIL_FROM=onboarding@resend.dev
